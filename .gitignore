# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/.swc
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results

# next.js
/.next/
/out/
.content-collections

# production
/build
/dist

# misc
.DS_Store
*.pem
*.key
*.p12
*.pfx
*.bak

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Keep deployment credentials local; commit only the example template.
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local data
/data/
